{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Renamix",
  "version": "0.8.1",
  "identifier": "com.junyou.regexbatchrenamer",
  "build": {
    "beforeDevCommand": "pnpm vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Renamix",
        "width": 1200,
        "height": 800,
        "dragDropEnabled": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "acceptFirstMouse": true,
        "minWidth": 1024,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "img-src": "'self' data: blob: https:",
        "font-src": "'self' data: https://fonts.gstatic.com",
        "connect-src": "ipc: http://ipc.localhost https://api.github.com",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-src": "'none'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "img-src": "'self' data: blob: https:",
        "font-src": "'self' data: https://fonts.gstatic.com",
        "connect-src": "ipc: http://ipc.localhost https://api.github.com ws://localhost:1420 http://localhost:1420",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-src": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": [
      "../public/icon.png",
      "../public/icon.ico",
      "../public/icon-mac.png"
    ]
  }
}
